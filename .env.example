# Copy this file to .env.local for local development.
# In production (Vercel) set these as Environment Variables in the project
# settings - never commit real secrets to git.

# ---- AI provider keys (server-side only, never exposed to the browser) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: override which model each provider uses. See lib/config.ts.
# OPENAI_MODEL=gpt-4.1
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: disable a provider entirely without removing its key.
# OPENAI_ENABLED=true
# GEMINI_ENABLED=true
# ANTHROPIC_ENABLED=true

# ---- cPanel database API (see /cpanel-api) ----
# The full URL to api.php on your cPanel hosting, e.g.
# https://yourdomain.com/ai-checker-api/api.php
DATABASE_API_URL=
# Shared secret - must match `api_secret` in cpanel-api/config.php
DATABASE_API_SECRET=

# ---- App ----
# Public URL of this Next.js app (used for links/metadata).
APP_URL=http://localhost:3000
# Where the "I want the full report" CTA at the end of the report links to.
# Can be a relative path (e.g. /contact) or a full external URL.
FULL_REPORT_CTA_URL=/contact

# Admin dashboard password. Never hard-code this in source.
ADMIN_SECRET=

# ---- Development ----
# When true, no real AI API calls are made - deterministic mock responses
# are returned instead, so you can build/demo the UI without spending
# API credits. See lib/providers/mock.ts.
MOCK_AI=true

# ---- Query volume (configurable per plan, see lib/config.ts) ----
FREE_QUERY_COUNT=5
FULL_QUERY_COUNT=10
# Which of the two tiers above is actually used for new audits right now.
ACTIVE_QUERY_COUNT=5

# How many AI provider calls run in parallel per processing tick.
AI_CONCURRENCY=4
# How many pending checks a single processing tick performs.
PROCESS_BATCH_SIZE=4
# How many times a failed provider call is retried before giving up.
AI_RETRY_LIMIT=1

# Default language for generated search queries: he | en
DEFAULT_LANGUAGE=he
